{
  "$comment": "Read-only daily checks of the live site. Prices come from projects/hatchelite/products.md (source: v2-latest src/config/productConfig.js). Never signs in, never pays.",
  "baseUrl": "https://hatchelite.com",
  "pages": [
    { "path": "/", "expectStatus": 200 },
    { "path": "/pricing", "expectText": ["$19.99", "$129.99", "7-day free trial", "Start 7-Day Free Trial"],
      "clickText": "Start 7-Day Free Trial", "expectUrlAfterClick": "/auth" },
    { "path": "/blog", "expectStatus": 200 },
    { "path": "/privacy", "expectStatus": 200 },
    { "path": "/terms", "expectStatus": 200 },
    { "path": "/sitemap.xml", "expectStatus": 200, "raw": true },
    { "path": "/robots.txt", "expectStatus": 200, "raw": true, "expectText": ["Sitemap:"] }
  ],
  "lighthouse": ["/", "/pricing", "/blog"]
}
