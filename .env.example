# Copy to .env.local and fill in. Never commit .env.local.
# None of these are sent to the browser (no NEXT_PUBLIC_ prefix).

# Public URL of this app (used in sign-up confirmation emails)
APP_URL=http://localhost:3000

# --- Phase 1: required ---------------------------------------------------
# Supabase > Project settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# DataForSEO > API access (login + API password, not your website password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# One GitHub fine-grained token PER PROJECT, each limited to that project's own repo
# (Contents + Pull requests: Read and write). The suffix is the project slug in capitals.
# The engine never uses one project's token for another, and has no unscoped fallback.
GITHUB_TOKEN__HATCHELITE=
GITHUB_TOKEN__EVA_VIDEO_STUDIO=

# --- Social publishing (approved posts only) ---------------------------------
# Buffer API key (Buffer > Settings > API). Free plan has one key per account, so it may be shared;
# posts still only go to channels linked to the post's own project. A per-project key wins if set.
BUFFER_API_KEY=
# BUFFER_API_KEY__HATCHELITE=
# BUFFER_API_KEY__EVA_VIDEO_STUDIO=
# Postiz (open-source alternative). Self-hosted: POSTIZ_API_URL=https://your-postiz/api/public/v1
# POSTIZ_API_KEY=
# POSTIZ_API_URL=

# --- Later phases (not used by Phase 1 features) ---------------------------
OPENAI_API_KEY=
# Service-account JSON (one line), added as a Restricted user to each site's Search Console property
GSC_SERVICE_ACCOUNT_JSON=
TRIGGER_SECRET_KEY=
