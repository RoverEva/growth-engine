# Copy to .env.local and fill in. Never commit .env.local.
# None of these are sent to the browser (no NEXT_PUBLIC_ prefix).

# Public URL of this app (used in sign-up confirmation emails)
APP_URL=http://localhost:3000

# --- Phase 1: required ---------------------------------------------------
# Supabase > Project settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# DataForSEO > API access (login + API password, not your website password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# GitHub fine-grained token, repository RoverEva/hatchelite only:
# Contents: Read and write, Pull requests: Read and write
GITHUB_TOKEN=

# --- Later phases (not used by Phase 1 features) ---------------------------
OPENAI_API_KEY=
# Service-account JSON (one line) with access to the hatchelite.com property
GSC_SERVICE_ACCOUNT_JSON=
TRIGGER_SECRET_KEY=
